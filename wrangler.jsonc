{
  // Cloudflare Workers (static assets + SSR worker) configuration for
  // @opennextjs/cloudflare. Deploy with `pnpm deploy:cf` after setting the
  // environment variables listed in README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photo-blog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
