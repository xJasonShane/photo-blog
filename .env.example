# ===============================================
# 复制本文件为 .env.local（本地开发）或在部署平台配置环境变量
# ===============================================

# ---------- 站点 ----------
# 你的站点域名（不含协议，用于绝对 URL / OG 图 / RSS）。
# 本地开发无需设置（默认 http://localhost:3000）
NEXT_PUBLIC_DOMAIN=photos.example.com

# 导航标题（默认显示域名）
# NEXT_PUBLIC_NAV_TITLE=My Photos

# 元信息
# NEXT_PUBLIC_META_TITLE=My Photo Blog
# NEXT_PUBLIC_META_DESCRIPTION=Photography portfolio with EXIF data

# ---------- 鉴权（必填） ----------
# 会话签名密钥，至少 32 位随机字符串：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string
# 管理员账号（用于 /sign-in 登录，登录后可上传/管理照片）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ---------- Cloudflare R2 对象存储（唯一的存储方式，必填） ----------
# 1. 创建 R2 桶（建议公开访问用于直出图片）
# 2. 创建 R2 API Token（对象读写权限），获得 Access Key / Secret Key
# 3. 绑定自定义域名或启用 r2.dev 公开访问作为 PUBLIC_DOMAIN
NEXT_PUBLIC_CLOUDFLARE_R2_BUCKET=my-photo-bucket
NEXT_PUBLIC_CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
# 桶的公开访问域名（不含 https://），如 photos.example.com 或 xxx.r2.dev
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_DOMAIN=pub-xxxx.r2.dev
# R2 API Token 凭据（元数据 JSON 与服务端文件操作均走 S3 兼容 API）
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# ---------- 界面与行为（可选，均为原项目支持的开关） ----------
# 首页使用网格布局（默认瀑布流全幅布局）
# NEXT_PUBLIC_GRID_HOMEPAGE=1
# 瀑布流网格（配合 GRID_HOMEPAGE）
# NEXT_PUBLIC_MASONRY_GRID=1
# 界面语言：zh-cn / en-us（默认）等
# NEXT_PUBLIC_LOCALE=zh-cn
# 默认主题：dark / light（默认跟随系统）
# NEXT_PUBLIC_DEFAULT_THEME=dark
# 保留原始文件不压缩上传
# NEXT_PUBLIC_PRESERVE_ORIGINAL_UPLOADS=1
# 开启 RSS / JSON 订阅（/rss.xml 与 /feed.json）
# NEXT_PUBLIC_SITE_FEEDS=1
# 允许访客下载原图
# NEXT_PUBLIC_ALLOW_PUBLIC_DOWNLOADS=1
# 照片分类可见性（逗号分隔，顺序即显示顺序）
# NEXT_PUBLIC_CATEGORY_VISIBILITY=recents,years,cameras,lenses,tags,albums,films,recipes,focal-lengths
# 启用按色彩排序
# NEXT_PUBLIC_COLOR_SORT=1

# ---------- AI（可选） ----------
# 设置 OpenAI 密钥后，上传照片可自动生成标题/标签/语义描述
# OPENAI_SECRET_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini

# ---------- 地点逆向解析（可选） ----------
# GOOGLE_PLACES_GEOCODING_API_KEY=xxx

# ---------- 限流（可选，Upstash Redis） ----------
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
